    "import matplotlib.pyplot as plt\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.metrics import r2_score\n",
    "import numpy as np # Importado, mas não usado diretamente neste snippet, comum em pacotes de ML\n",
    "\n",
    "# Função para analisar um mês específico\n",
    "def analisar_mes(numero_mes):\n",
    "    # Acessa o DataFrame do mês a partir do dicionário dfs_ms\n",
    "    # Garante que dfs_ms foi criado e que df_mes tem a coluna 'Total'\n",
    "    df_mes = dfs_ms[numero_mes]\n",
    "\n",
    "    # --- Plot de Vendas Diárias (Comportamento Geral) ---\n",
    "    plt.figure(figsize=(12, 6)) # Define o tamanho da figura para o gráfico\n",
    "    plt.plot(df_mes['Dia'], df_mes['Total'], marker='o', linestyle='-') # Plota o total de vendas por dia\n",
    "    plt.title(f'Comportamento de Vendas Diárias - Mês {numero_mes}') # Título do gráfico\n",
    "    plt.xlabel('Dia do Mês') # Rótulo do eixo X\n",
    "    plt.ylabel('Total de Vendas (R$)') # Rótulo do eixo Y\n",
    "    plt.grid(True) # Adiciona grade ao gráfico\n",
    "    plt.tight_layout() # Ajusta o layout para evitar sobreposição de elementos\n",
    "    plt.show() # Exibe o gráfico\n",
    "\n",
    "    # --- Regressão Linear: Dia do Mês vs. Total de Vendas ---\n",
    "    # Variável independente (Dia do Mês) deve ser 2D para scikit-learn\n",
    "    X = df_mes[['Dia']]\n",
    "    # Variável dependente (Total de Vendas)\n",
    "    y = df_mes['Total']\n",
    "\n",
    "    modelo = LinearRegression() # Inicializa o modelo de regressão linear\n",
    "    modelo.fit(X, y) # Treina o modelo com os dados de Dia e Total\n",
    "    y_pred = modelo.predict(X) # Faz previsões de vendas com base nos dias\n",
    "\n",
    "    # --- Visualização da Regressão Linear ---\n",
    "    plt.figure(figsize=(12, 6)) # Nova figura para o gráfico de regressão\n",
    "    plt.scatter(X, y, label='Dados Reais', alpha=0.7) # Plota os pontos de dados reais\n",
    "    # Plota a linha de regressão linear (previsões do modelo)\n",
    "    plt.plot(X, y_pred, color='red', linestyle='--', label='Linha de Regressão Linear')\n",
    "    plt.title(f'Regressão Linear: Vendas por Dia - Mês {numero_mes}') # Título do gráfico\n",
    "    plt.xlabel('Dia do Mês') # Rótulo do eixo X\n",
    "    plt.ylabel('Total de Vendas (R$)') # Rótulo do eixo Y\n",
    "    plt.legend() # Exibe a legenda\n",
    "    plt.grid(True) # Adiciona grade\n",
    "    plt.tight_layout() # Ajusta o layout\n",
    "    plt.show() # Exibe o gráfico\n",
    "\n",
    "    # --- Cálculo e Impressão do R² Score ---\n",
    "    # O R² (coeficiente de determinação) mede o quão bem o modelo de regressão se ajusta aos dados reais.\n",
    "    # Valores próximos de 1 indicam um bom ajuste, significando que o dia do mês explica bem a variação nas vendas.\n",
    "    r2 = r2_score(y, y_pred)\n",
    "    print(f'R² para o mês {numero_mes}: {r2:.2f}')\n",
    "\n",
    "# --- Aplicação da Análise para Múltiplos Meses ---\n",
    "# Loop para aplicar a função 'analisar_mes' para cada mês de Junho a Dezembro (6 a 12)\n",
    "for mes in range(6, 13):\n",
    "    print(f\"\\n{'='*30}\\n📊 Análise Detalhada  {mes} ({nomes_meses[mes]})\\n{'='*30}\")\n",
    "    analisar_mes(mes)"
